# =============================================================================
# GenerativeMiner Environment Configuration
# =============================================================================
# Copy this file to .env.miner and configure your settings
# cp .env.gen_miner.template .env.gen_miner

# =============================================================================
# GENERATION SERVICE SELECTION
# =============================================================================
# Choose which service to use for each modality:
#   openai      - DALL-E 3 / Sora video (requires OPENAI_API_KEY). OpenAI deprecates
#                 the Videos API and Sora 2 models; shutdown 2026-09-24 — prefer Runway
#                 for long-lived video (VIDEO_SERVICE=runway).
#   openrouter  - Image (any image-output model, default: gemini-3-pro-image-preview)
#                 + Video (Veo 3.1 / Seedance) via OpenRouter (requires
#                 OPEN_ROUTER_API_KEY). Video models gated to C2PA-capable only:
#                 (google/veo-3.1*, bytedance/seedance-*). Kling, Wan, Hailuo,
#                 and Sora are excluded — they don't produce verifiable C2PA.
#   stabilityai - Stability AI (requires STABILITY_API_KEY)
#   runway      - Runway text-to-video (requires RUNWAYML_API_KEY)
#   maxcheapai  - Nano Banana Pro + Veo 3.1 (requires MAXCHEAPAI_API_KEY)
#   plenxai     - Omni Flash video (requires PLENXAI_API_KEY)
#   ckey        - Nano Banana Pro images with Nano Banana 2 fallback (requires CKEY_API_KEY)
#   vertexgen   - Nano Banana Pro images (requires VERTEXGEN_API_KEY)
#   gpti2       - GPT Image images (requires GPTI2_API_KEY)
#   none        - Disable this modality (requests will be rejected)
#
# All services produce C2PA-signed content required by validators.
#
# If IMAGE_SERVICE / VIDEO_SERVICE are not set, every backend with a valid key is
# loaded; the first match in openai → openrouter → stabilityai → runway →
# maxcheapai → plenxai → ckey → vertexai → vertexgen → gpti2 wins per
# modality. For video, OpenAI (Sora) wins over Runway if both keys exist — set
# VIDEO_SERVICE=runway explicitly to use Runway for /gen_video. Set
# VIDEO_SERVICE=openrouter to use Veo/Seedance via OpenRouter.
IMAGE_SERVICE=maxcheapai
VIDEO_SERVICE=plenxai


# =============================================================================
# API KEYS (configure the services you want to use)
# =============================================================================

# OpenAI DALL-E
OPENAI_API_KEY=

# OpenRouter (multi-model access - recommended)
OPEN_ROUTER_API_KEY=

# Stability AI
STABILITY_API_KEY=

# Runway (text-to-video when VIDEO_SERVICE=runway). RUNWAYML_API_SECRET is an alias (SDK default).
RUNWAYML_API_KEY=

# MaxCheapAI (Nano Banana Pro images + Veo 3.1 video)
MAXCHEAPAI_API_KEY=
MAXCHEAPAI_SPEED=priority
MAXCHEAPAI_POLL_INTERVAL=10
MAXCHEAPAI_POLL_TIMEOUT=1800
MAXCHEAPAI_MAX_RETRIES=3
MAXCHEAPAI_RETRY_DELAY=10

# PlenXAI (video-only Omni Flash)
PLENXAI_API_KEY=
PLENXAI_POLL_INTERVAL=4
PLENXAI_POLL_TIMEOUT=1800
PLENXAI_MAX_RETRIES=3
PLENXAI_RETRY_DELAY=5

# CKey (image-only Nano Banana Pro with Nano Banana 2 fallback)
CKEY_API_KEY=
CKEY_REQUEST_TIMEOUT=1800
CKEY_DOWNLOAD_TIMEOUT=600
CKEY_RETRY_DELAY=10

# VertexGen (image-only Nano Banana Pro)
# The provider's current default endpoint is plain HTTP. Prefer an HTTPS base URL
# through VERTEXGEN_API_BASE_URL when one becomes available.
VERTEXGEN_API_KEY=
VERTEXGEN_API_BASE_URL=http://107.178.109.250:8686/v1
VERTEXGEN_WAIT_SECONDS=20
VERTEXGEN_REQUEST_TIMEOUT=60
VERTEXGEN_POLL_INTERVAL=2
VERTEXGEN_POLL_TIMEOUT=600
VERTEXGEN_DOWNLOAD_TIMEOUT=600
VERTEXGEN_MAX_RETRIES=3
VERTEXGEN_RETRY_DELAY=10

# GPTi2 (image-only GPT Image)
GPTI2_API_KEY=
GPTI2_MODEL=gpt-image-2.5-sunburst
GPTI2_API_BASE_URL=https://gpti2.store/v1
GPTI2_REQUEST_TIMEOUT=1800
GPTI2_POLL_INTERVAL=5
GPTI2_POLL_TIMEOUT=1800
GPTI2_DOWNLOAD_TIMEOUT=600


# Hugging Face (for model downloads)
HUGGINGFACE_HUB_TOKEN=

# Google Cloud (if using Vertex AI)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1  
# GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# BITTENSOR NETWORK
# =============================================================================

# Network Configuration
BT_NETUID=379
BT_CHAIN_ENDPOINT=wss://test.finney.opentensor.ai:443

# Wallet
BT_WALLET_NAME=ddz
BT_WALLET_HOTKEY=ddz0

# Axon (your miner's endpoint)
BT_AXON_PORT=8093
BT_AXON_IP=0.0.0.0
# BT_AXON_EXTERNAL_IP=your.public.ip

# =============================================================================
# MINER SETTINGS
# =============================================================================

# Performance
MINER_DEVICE=auto
MINER_MAX_CONCURRENT_TASKS=5
MINER_WORKER_THREADS=5
MINER_TASK_TIMEOUT=1800

# Storage
HF_HOME=/workspace/.cache/huggingface

# Set to true to save generated images/videos under MINER_OUTPUT_DIR/image/ and .../video/
MINER_SAVE_LOCALLY=true
MINER_OUTPUT_DIR=./miner_generated_content

# Optional: durable task snapshots for restart recovery (default: <MINER_OUTPUT_DIR>/.gen_miner_state)
# MINER_STATE_DIR=


# =============================================================================
# LOGGING
# =============================================================================

BT_LOGGING_LEVEL=INFO

# =============================================================================
# USAGE EXAMPLES
# =============================================================================

# Start miner:     gascli generator start
# Check status:    gascli generator status  
# View logs:       gascli generator logs -f
# Direct PM2:      pm2 start miner.config.js

# Get API keys:
# - OpenAI: https://platform.openai.com/api-keys
# - OpenRouter: https://openrouter.ai/keys
# - Runway: https://app.runwayml.com/ (API keys / dev portal)
# - MaxCheapAI: https://maxcheapai.com/en/docs
# - PlenXAI: https://plenxai.com/docs
# - CKey: https://api.xah.io
# - VertexGen: http://107.178.109.250:8686
# - GPTi2: https://gpti2.store
# - Hugging Face: https://huggingface.co/settings/tokens
